            "post": {
                "tags": [
                    "Groupes"
                ],
                "summary": "Créer une nouvelle tontine",
                "operationId": "0dbd5970197eb93f2a1ed934c341aeab",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Tontine Famille"
                                    },
                                    "contribution_amount": {
                                        "type": "number",
                                        "example": 10000
                                    },
                                    "max_members": {
                                        "type": "integer",
                                        "example": 5
                                    },
                                    "frequency": {
                                        "type": "string",
                                        "enum": [
                                            "weekly",
                                            "biweekly",
                                            "monthly"
                                        ]
                                    },
                                    "payout_method": {
                                        "type": "string",
                                        "enum": [
                                            "sequential",
                                            "random",
                                            "bidding"
                                        ]
                                    },
                                    "insurance_opt_in": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date-time"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Groupe créé"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
